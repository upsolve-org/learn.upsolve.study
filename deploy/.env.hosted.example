# Hosted deployment — /srv/learn/.env.local on flow-vps (PR 7).
# Copy to .env.local, fill the required values, chmod 600. Never commit it.

# --- Mode & origins -------------------------------------------------------
HOSTED_MODE=on
APP_ORIGIN=https://learn.upsolve.study
NEXT_PUBLIC_SITE_URL=https://learn.upsolve.study
LH_ALLOWED_HOSTS=learn.upsolve.study
ADMIN_EMAIL=you@example.com
# Optional: an implicitly admitted address kept from the pilot deployment.
HOSTED_PILOT_EMAIL=

# --- Standalone Postgres (deploy/docker-compose.yml, loopback :5433) ------
DATABASE_URL=postgresql://learn:CHANGE_ME@127.0.0.1:5433/learn
POSTGRES_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Storage backend ------------------------------------------------------
# postgres: chats/graph/jobs/settings live in Postgres. Sub-agent jobs
# (research/demo/visual/pdf) are then ENQUEUED and run by the worker
# (deploy/learn-worker.service) — that unit MUST be running, or jobs wait.
# Admissions, signups and plugin data stay as files under ./data.
STORAGE_BACKEND=postgres

# --- Blob store (RustFS/S3, loopback :9000) -------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=learn-blobs
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=us-east-1

# --- Sandboxed Chromium (browserless on loopback :3003) -------------------
# Must be ws:// or wss://; an http:// health URL is ignored.
CHROME_WS_ENDPOINT=ws://127.0.0.1:3003

# --- Local Parakeet STT (stt-gateway on loopback :8792) -------------------
# When set, /api/stt/token returns { mode: "local" } and dictation uploads a
# WAV to /api/stt/transcribe instead of opening a Deepgram WebSocket.
STT_GATEWAY_URL=http://127.0.0.1:8792
STT_GATEWAY_MODEL=parakeet-tdt-0.6b-v2

# --- Free-tier web search (Exa) ------------------------------------------
EXA_API_KEY=

# --- Hosted default model -------------------------------------------------
HOSTED_DEFAULT_BASE_URL=https://openrouter.ai/api/v1
HOSTED_DEFAULT_MODEL=CHANGE_ME
HOSTED_DEFAULT_API_KEY=
HOSTED_DEFAULT_CONTEXT_WINDOW=1000000
HOSTED_DEFAULT_MAX_TOKENS=1000000

# --- Approval email (Resend) ---------------------------------------------
RESEND_API_KEY=
RESEND_FROM=UPsolve <noreply@upsolve.study>

# --- Provider BYOK keys (optional; can also be set in the Keys UI) --------
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
